{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "resolveJsonModule": true, "esModuleInterop": true,
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "tests/**/*.ts"],
  "exclude": ["src/business"]
}
